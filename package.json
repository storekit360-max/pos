{
  "name": "the-smart-pos",
  "version": "1.4.2",
  "description": "The Smart - POS & Inventory for mobile phone and accessories shop",
  "main": "main.js",
  "scripts": {
    "start": "node launch.js",
    "license:setup": "node scripts/setup-desktop-license.js",
    "license:prepare": "npm run license:setup && node scripts/sync-desktop-license-key.js",
    "seed:superadmin": "node scripts/seed-superadmin.js",
    "tenant:delete": "node scripts/delete-tenant.js",
    "tenants:delete-all": "node scripts/delete-all-tenants.js",
    "dist:win": "npm run license:prepare && electron-builder --win nsis --x64 && node scripts/prepare-client.js win",
    "dist:mac": "npm run license:prepare && electron-builder --mac dmg --arm64 && electron-builder --mac dmg --x64 && node scripts/prepare-client.js mac",
    "dist:mac:x64": "npm run license:prepare && electron-builder --mac dmg --x64 && node scripts/prepare-client.js mac-x64",
    "release:stage": "node scripts/prepare-update-manifest.js",
    "release:manifest": "node scripts/prepare-update-manifest.js",
    "build:ui-manifest": "node scripts/build-ui-manifest.js",
    "verify:live": "node scripts/verify-live-update.js"
  },
  "devDependencies": {
    "electron": "^33.0.0",
    "electron-builder": "^24.13.3",
    "electron-reload": "^2.0.0-alpha.1"
  },
  "dependencies": {
    "mongodb": "^6.12.0"
  },
  "build": {
    "appId": "lk.thesmart.pos",
    "productName": "The Smart POS",
    "files": [
      "main.js",
      "preload.js",
      "customer-preload.js",
      "updater.js",
      "renderer/**/*"
    ],
    "win": {
      "target": [
        "nsis"
      ],
      "artifactName": "The-Smart-POS-Setup-${version}.${ext}",
      "signAndEditExecutable": false
    },
    "mac": {
      "target": [
        "dmg"
      ],
      "artifactName": "The-Smart-POS-${version}-${arch}.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "deleteAppDataOnUninstall": false,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "runAfterFinish": true
    }
  },
  "uiMinShell": "1.4.2"
}
